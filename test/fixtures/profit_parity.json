{
  "description": "Shared by test/profit_tracking_test.dart (DatabaseHelper.getProfitSummary) and backend/pharmacy_data/tests.py (_profit_summary via /api/reports/summary/). Both must produce exactly `expected` for the same data. All rows dated today. `purchase_list` is a second shared scenario: test/purchase_list_db_test.dart (DatabaseHelper.createPurchaseList) and backend PurchaseListTests (/api/purchase-invoices/from-list/) must both reach its `expected` (bonus effective cost, free lines at known cost 0, weighted average, invoice total excluding bonus/free, then profit when selling it all). Expiry dates are filled in by the tests (today + 365 days).",
  "medicines": {
    "A": {"avg_cost": 400},
    "B": {"avg_cost": 300},
    "C": {"avg_cost": null}
  },
  "invoices": [
    {
      "note": "multi-line, amount discount spread proportionally: 3000 - 100 - 1100 = 1800",
      "number": "INV-000001", "discount": 100, "is_refunded": false,
      "items": [
        {"medicine": "A", "quantity": 2, "unit_price": 1000, "unit_cost": 400},
        {"medicine": "B", "quantity": 1, "unit_price": 1000, "unit_cost": 300}
      ]
    },
    {
      "note": "12% of 1255 = 150.60 (POS rounding); only the costed 1000 carries a share: 150.60*1000/1255 = 120 -> 1000 - 120 - 400 = 480",
      "number": "INV-000002", "discount": 150.60, "is_refunded": false,
      "items": [
        {"medicine": "A", "quantity": 1, "unit_price": 1000, "unit_cost": 400},
        {"medicine": "C", "quantity": 1, "unit_price": 255, "unit_cost": null}
      ]
    },
    {
      "note": "discount pushes the sale below cost: 1000 - 600 - 600 = -200",
      "number": "INV-000003", "discount": 600, "is_refunded": false,
      "items": [
        {"medicine": "B", "quantity": 2, "unit_price": 500, "unit_cost": 300}
      ]
    },
    {
      "note": "refunded discounted invoice: excluded entirely",
      "number": "INV-000004", "discount": 50, "is_refunded": true,
      "items": [
        {"medicine": "A", "quantity": 1, "unit_price": 1000, "unit_cost": 400}
      ]
    },
    {
      "note": "legacy negative discount (older offline app): share applied when != 0 on both sides: 1000 + 100 - 300 = 800",
      "number": "INV-000005", "discount": -100, "is_refunded": false,
      "items": [
        {"medicine": "B", "quantity": 1, "unit_price": 1000, "unit_cost": 300}
      ]
    }
  ],
  "expenses": [250],
  "damaged": [
    {"medicine": "A", "quantity": 1, "total_cost": 400, "reason": "broken"},
    {"medicine": "B", "quantity": 1, "total_cost": 300, "reason": "correction"},
    {"medicine": "C", "quantity": 1, "total_cost": null, "reason": "broken"}
  ],
  "expected": {
    "revenue": 5504.40,
    "cost_of_goods_sold": 2400,
    "gross_profit": 2880,
    "damage_cost": 400,
    "net_profit": 2230,
    "items_without_cost": 1
  },
  "purchase_list": {
    "existing": {"trade_name": "A", "quantity": 10, "buy_price": 500, "sell_price": 1000},
    "lines": [
      {
        "note": "existing A: 10 paid x 1000 + 2 bonus -> batch 12 @ 833.3333; avg (10*500 + 12*833.3333)/22 = 681.8182",
        "trade_name": "A", "quantity": 10, "bonus_quantity": 2, "is_free": false, "buy_price": 1000, "sell_price": 1500
      },
      {
        "note": "new N, fully free: 5 units at known cost 0, buy_price 0",
        "trade_name": "N", "quantity": 0, "bonus_quantity": 5, "is_free": true, "buy_price": null, "sell_price": 200
      },
      {
        "note": "existing A, fully free, no sell price: keeps 1500 and buy_price 1000; avg (22*681.8182 + 3*0)/25 = 600",
        "trade_name": "A", "quantity": 0, "bonus_quantity": 3, "is_free": true, "buy_price": null, "sell_price": null
      }
    ],
    "sale": [{"medicine": "A", "quantity": 25}, {"medicine": "N", "quantity": 5}],
    "expected": {
      "invoice_total": 10000,
      "item_count": 3,
      "line_totals": [10000, 0, 0],
      "effective_unit_costs": [833.3333, 0, 0],
      "medicines": {
        "A": {"quantity": 25, "avg_cost": 600, "buy_price": 1000, "sell_price": 1500, "batch_costs": [0, 500, 833.3333]},
        "N": {"quantity": 5, "avg_cost": 0, "buy_price": 0, "sell_price": 200, "batch_costs": [0]}
      },
      "profit": {"revenue": 38500, "cost_of_goods_sold": 15000, "gross_profit": 23500, "items_without_cost": 0}
    }
  },
  "supplier_returns": {
    "note": "Replayed by test/supplier_returns_db_test.dart and backend tests_supplier_returns.py. After every step both sides must report the same supplier balance (positive = debt, negative = credit for the pharmacy), available credit, invoice remainders and stock, and the statement's debt_added must sum to the balance. Expiry dates are filled in by the tests.",
    "steps": [
      {
        "op": "list", "invoice": "F-1", "paid": 9000,
        "lines": [
          {"key": "A", "trade_name": "A", "quantity": 10, "bonus_quantity": 2, "is_free": false, "buy_price": 1000, "sell_price": 1500},
          {"key": "G", "trade_name": "Gift", "quantity": 0, "bonus_quantity": 3, "is_free": true, "buy_price": null, "sell_price": 200}
        ],
        "expect": {"balance": 1000, "available_credit": 0, "remaining": {"F-1": 1000}, "stock": {"A": 12, "Gift": 3}}
      },
      {
        "note": "4 paid units at an edited price 900 = 3600; 1000 settles F-1, the excess 2600 becomes credit",
        "op": "return", "invoice": "F-1", "lines": [{"key": "A", "quantity": 4, "unit_price": 900}],
        "expect": {"balance": -2600, "available_credit": 2600, "remaining": {"F-1": 0}, "stock": {"A": 8, "Gift": 3},
                   "return_credit": 3600, "return_excess": 2600}
      },
      {
        "note": "8 units left on the line: 6 paid at the default price 1000 = 6000, the 2 bonus units and the free line give 0",
        "op": "return", "invoice": "F-1", "lines": [{"key": "A", "quantity": 8}, {"key": "G", "quantity": 3}],
        "expect": {"balance": -8600, "available_credit": 8600, "remaining": {"F-1": 0}, "stock": {"A": 0, "Gift": 0},
                   "return_credit": 6000, "return_excess": 6000}
      },
      {
        "note": "new list 5000: credit applied automatically (partial use of the 8600 credit)",
        "op": "list", "invoice": "F-2", "paid": 0,
        "lines": [{"key": "B", "trade_name": "B", "quantity": 5, "bonus_quantity": 0, "is_free": false, "buy_price": 1000, "sell_price": 1300}],
        "expect": {"balance": -3600, "available_credit": 3600, "remaining": {"F-1": 0, "F-2": 0}, "credit_applied": {"F-2": 5000}}
      },
      {
        "op": "refund", "amount": 1000,
        "expect": {"balance": -2600, "available_credit": 2600}
      },
      {
        "note": "new list 4000: the whole remaining 2600 credit is applied, 400 paid now, 1000 left",
        "op": "list", "invoice": "F-3", "paid": 400,
        "lines": [{"key": "C", "trade_name": "C", "quantity": 2, "bonus_quantity": 0, "is_free": false, "buy_price": 2000, "sell_price": 2500}],
        "expect": {"balance": 1000, "available_credit": 0, "remaining": {"F-1": 0, "F-2": 0, "F-3": 1000}, "credit_applied": {"F-3": 2600}}
      }
    ],
    "final_avg_cost": {"A": 800},
    "statement": {
      "note": "Final statement after all steps, chronological: [type, invoice number, increase (+), decrease (-), info amount (credit applied, no effect on the balance), balance after]. Both sides must produce exactly this order (an invoice before its own credit application and 'paid now' payment); the closing balance equals the supplier balance.",
      "rows": [
        ["invoice", "F-1", 10000, 0, 0, 10000],
        ["payment", "F-1", 0, 9000, 0, 1000],
        ["return", "F-1", 0, 3600, 0, -2600],
        ["return", "F-1", 0, 6000, 0, -8600],
        ["invoice", "F-2", 5000, 0, 0, -3600],
        ["credit_applied", "F-2", 0, 0, 5000, -3600],
        ["refund", null, 1000, 0, 0, -2600],
        ["invoice", "F-3", 4000, 0, 0, 1400],
        ["credit_applied", "F-3", 0, 0, 2600, 1400],
        ["payment", "F-3", 0, 400, 0, 1000]
      ],
      "closing": 1000
    }
  },
  "return_cost": {
    "note": "Replayed by test/supplier_returns_db_test.dart and backend tests_supplier_returns.py. One medicine 'A' (sell price 1500). Returned units leave at their credit: avg = (avg*qty_before - credit)/qty_after; qty_after 0 keeps avg; negative -> 0. 'list' lines: quantity/bonus/buy/expiry_days. 'sell' uses the sell price. 'return' takes that invoice's batches first, then FEFO. When 'profit' is given everything has been sold: lifetime profit (sum of (unit_price - unit_cost) * qty) must equal it and, when 'cash_profit' is true, equal sales - purchases + credits.",
    "cases": [
      {
        "name": "credit at purchase cost (2,250)",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "unit_price": 750, "expect": {"avg_cost": 500, "stock": 3, "credit": 2250}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 500, "stock": 0}}
        ],
        "profit": 3000, "cash_profit": true
      },
      {
        "name": "supplier credited less (2,100)",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "unit_price": 700, "expect": {"avg_cost": 550, "stock": 3, "credit": 2100}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 550, "stock": 0}}
        ],
        "profit": 2850, "cash_profit": true
      },
      {
        "name": "supplier credited more (2,400)",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "unit_price": 800, "expect": {"avg_cost": 450, "stock": 3, "credit": 2400}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 450, "stock": 0}}
        ],
        "profit": 3150, "cash_profit": true
      },
      {
        "name": "line batch present: return 2 of F-2 after a sale took the F-1 batch",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 200, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 400, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 625, "stock": 3}},
          {"op": "return", "invoice": "F-2", "quantity": 2, "unit_price": 750, "expect": {"avg_cost": 375, "stock": 1, "credit": 1500, "batch_prices": [750]}},
          {"op": "sell", "quantity": 1, "expect": {"avg_cost": 375, "stock": 0}}
        ],
        "profit": 3750, "cash_profit": true
      },
      {
        "name": "line batch already consumed by FEFO: same return taken from the F-1 batch gives the same numbers",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 625, "stock": 3}},
          {"op": "return", "invoice": "F-2", "quantity": 2, "unit_price": 750, "expect": {"avg_cost": 375, "stock": 1, "credit": 1500, "batch_prices": [500]}},
          {"op": "sell", "quantity": 1, "expect": {"avg_cost": 375, "stock": 0}}
        ],
        "profit": 3750, "cash_profit": true
      },
      {
        "name": "bonus units returned with 0 credit raise avg",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 2, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 468.75, "stock": 8}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "expect": {"avg_cost": 300, "stock": 5, "credit": 2250}},
          {"op": "return", "invoice": "F-2", "quantity": 2, "expect": {"avg_cost": 500, "stock": 3, "credit": 0}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 500, "stock": 0}}
        ],
        "profit": 3000, "cash_profit": true
      },
      {
        "name": "returning everything keeps avg (qty_after = 0); the next purchase starts fresh",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "unit_price": 700, "expect": {"avg_cost": 550, "stock": 3, "credit": 2100}},
          {"op": "return", "invoice": "F-1", "quantity": 3, "expect": {"avg_cost": 550, "stock": 0, "credit": 1500}},
          {"op": "list", "invoice": "F-3", "quantity": 2, "bonus": 0, "buy": 900, "expiry_days": 300, "expect": {"avg_cost": 900, "stock": 2}}
        ]
      },
      {
        "name": "negative result is floored at 0",
        "steps": [
          {"op": "list", "invoice": "F-1", "quantity": 3, "bonus": 0, "buy": 500, "expiry_days": 400, "expect": {"avg_cost": 500, "stock": 3}},
          {"op": "list", "invoice": "F-2", "quantity": 3, "bonus": 0, "buy": 750, "expiry_days": 200, "expect": {"avg_cost": 625, "stock": 6}},
          {"op": "return", "invoice": "F-2", "quantity": 3, "unit_price": 1300, "expect": {"avg_cost": 0, "stock": 3, "credit": 3900}},
          {"op": "sell", "quantity": 3, "expect": {"avg_cost": 0, "stock": 0}}
        ],
        "profit": 4500
      }
    ]
  }
}
